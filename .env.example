# Путь к проекту
RCS_OT_HOME=/srv/rcs_ot

# База данных
# SQLite (для тестирования):
DATABASE_URL=sqlite:///data/rcs_ot.db

# PostgreSQL (для production):
# DATABASE_URL=postgresql://rcs_ot:password@localhost:5432/rcs_ot

# Секретный ключ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-random-string-min-64-chars-long

# Администратор (создается при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Администратор системы

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Кэш
# memory (для тестирования) или redis (для production)
CACHE_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# Сессии
SESSION_TIMEOUT=30
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# Безопасность
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# Загрузки
UPLOAD_MAX_SIZE=52428800
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# SMTP (для отправки уведомлений)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=АСУ ОТ <noreply@example.com>
SMTP_USE_TLS=true

# Уведомления
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_WEBHOOK_ENABLED=false
# NOTIFICATION_WEBHOOK_URL=https://hooks.example.com/notify

# CORS (для разработки)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Timezone
TIMEZONE=Europe/Moscow

# Язык
LANGUAGE=ru

# Debug (НЕ ВКЛЮЧАЙТЕ В PRODUCTION!)
DEBUG=false
