# База данных
# SQLite (по умолчанию для Windows):
DATABASE_URL=sqlite:///./data/rcs_ot.db

# PostgreSQL (для production):
# DATABASE_URL=postgresql://user:password@localhost:5432/rcs_ot

# Секретный ключ (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
# Генерация: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-random-string-min-32-chars-long-in-production

# Режим отладки (false для production)
DEBUG=true

# Хост и порт сервера
HOST=0.0.0.0
PORT=8000

# Время жизни токена (минуты)
ACCESS_TOKEN_EXPIRE_MINUTES=30
